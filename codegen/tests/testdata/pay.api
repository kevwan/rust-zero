syntax = "v1"

struct PayReq {
    #[json("order_id")]
    #[validate(required, length(1, 32))]
    orderId: String,
    #[validate(range(1, 1000000))]
    amount: i64,
    #[validate(one_of("cny", "usd"))]
    currency: String,
}

struct PayResp {
    ok: bool,
    extra: {String: String},
}

service pay {
    #[handler(createPay)]
    post /pay (PayReq) -> PayResp
}
